# 네이버 개발자센터(https://developers.naver.com/apps)에서
# "데이터랩(검색어트렌드)" API 사용 설정 후 발급받은 애플리케이션 키를 입력하세요.
# 이 값이 비어 있으면 대시보드의 검색어 트렌드 섹션은 에러 없이 "설정 필요" 상태로 표시됩니다.
# 이 파일을 .env.local로 복사해서 실제 값을 넣어주세요 (.env.local은 git에 커밋되지 않습니다).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (선택) Vercel Cron이 /api/cron/refresh를 호출할 때 쓰는 비밀값입니다.
# Vercel 프로젝트 설정 > Environment Variables에 CRON_SECRET을 추가해두면
# Vercel이 크론 요청에 자동으로 Authorization: Bearer <값> 헤더를 붙여줍니다.
# 비워두면(로컬 개발 등) 인증 없이 동작합니다.
CRON_SECRET=

# 크롤링한 뉴스 데이터를 저장하는 Vercel Blob 저장소 토큰입니다.
# Vercel 프로젝트 > Storage > Create Database > Blob 으로 Blob Store를 만들고
# 프로젝트에 연결하면, Vercel이 이 값을 프로젝트 환경변수에 자동으로 넣어줍니다.
# 로컬 개발에서는 비워두면 data/naver-news.json 파일로 대신 저장됩니다.
BLOB_READ_WRITE_TOKEN=
